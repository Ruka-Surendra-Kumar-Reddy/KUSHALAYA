# Copy to /etc/workforceos/safehome.env and edit before running deploy-safehome.sh
#
#   sudo mkdir -p /etc/workforceos
#   sudo cp scripts/deploy/deploy.safehome.env.example /etc/workforceos/safehome.env
#   sudo chmod 600 /etc/workforceos/safehome.env
#   sudo bash scripts/deploy/deploy-safehome.sh

# --- Shared platform (cloned to /opt/workforceos-core, group opc) ---
WORKFORCEOS_CORE_REPO=https://github.com/krishnaposa/workforceos-core.git
WORKFORCEOS_CORE_BRANCH=develop
WORKFORCEOS_CORE_PATH=/opt/workforceos-core

# --- SafeHome / LiveWell app ---
APP_REPO=https://github.com/krishnaposa/SafeHomeOps.git
# Branch for a FRESH clone only. Updates are tarballs (scripts/release.sh ->
# scripts/deploy/apply-release.sh); the VM checkout is never `git pull`ed.
APP_BRANCH=develop
APP_ROOT=/opt/safehomeops/app
APP_USER=safehomeops
# Ops / portal / API (assessor, staff, family portal)
APP_DOMAIN=ops.kushalaya.com
# Public family marketing homepage
MARKETING_DOMAIN=www.kushalaya.com
# Old brand's ops host — leave serving in place for now; add a real 301 later
# once the new domain is confirmed stable (see deploy/nginx/livewellops.tekmatrix.ai.conf).
LEGACY_APP_DOMAIN=
INSTALL_LEGACY_REDIRECT=0
INSTALL_FAMILY_REDIRECT=0
# start-livewell-services.sh auto-promotes APP_DOMAIN to ops.kushalaya.com
# unless KEEP_APP_DOMAIN=1. Keeping it at 1 is still the safe choice: it pins
# APP_DOMAIN to exactly what is set above rather than letting the script decide.
KEEP_APP_DOMAIN=1
# Apex kushalaya.com and kushalaya.in redirect to MARKETING_DOMAIN via
# deploy/nginx/kushalaya.com-redirect.conf and kushalaya.in-redirect.conf —
# install_nginx_site has no generic redirect fallback, so these must be
# installed manually (see docs/deploy/DEPLOY_UPDATE.md or ask the guide).

# Optional: export GITHUB_TOKEN=ghp_...  (private repos)

# --- PostgreSQL ---
APP_DB_USER=safehomeops
APP_DB_NAME=safehomeops
APP_DB_PASSWORD=CHANGE_ME_SAFEHOME_DB
# If you created the role/DB manually: set your password above and:
# PRESERVE_DB_PASSWORD=1    # do not ALTER ROLE password on re-deploy
# SKIP_DB_SETUP=1           # skip role/DB creation entirely (pg_hba still runs unless you skip deploy DB block)

# --- PostgreSQL backups (scripts/deploy/backup-safehome-postgres.sh) ---
# Install daily cron: sudo bash scripts/deploy/install-safehome-postgres-backup-cron.sh
# Docs: docs/deploy/POSTGRES_BACKUP.md
# BACKUP_DIR=/var/backups/safehomeops/postgres
# BACKUP_RETENTION_DAYS=14
# BACKUP_FORMAT=plain          # plain (.sql.gz) | custom (.dump)
# BACKUP_PREFIX=safehomeops
# BACKUP_CRON_SCHEDULE=15 2 * * *
# Optional offsite copy; $1 is the new backup file path:
# BACKUP_OFFSITE_CMD=rsync -az "$1" backup@vault:/data/safehomeops/postgres/

# --- App secret (generate: openssl rand -hex 32) ---
APP_SECRET_KEY=CHANGE_ME_SAFEHOME_SECRET

# --- TLS (Let's Encrypt for APP_DOMAIN + MARKETING_DOMAIN; + legacy when redirect enabled) ---
SKIP_TLS=0
CERTBOT_EMAIL=admin@kushalaya.com

# Family marketing CTAs (www.kushalaya.com → /marketing). Digits only for WhatsApp.
# NEXT_PUBLIC_FAMILY_WHATSAPP=9198XXXXXXXX
# NEXT_PUBLIC_FAMILY_PHONE=+91 40 XXXX XXXX
# Parent Care Check: branded page at /parent-care-check (embeds Google Form)
# NEXT_PUBLIC_PARENT_CARE_CHECK_URL=/parent-care-check
# NEXT_PUBLIC_PARENT_CARE_CHECK_EMBED_URL=https://docs.google.com/forms/d/e/1FAIpQLSeQjLpuzdIvkIPEIizSdkDn5SSS-ZD2_PkS_hjHAdsZL_V4Ww/viewform?embedded=true
# Families have their own host so they never see an "ops" URL.
FAMILY_DOMAIN=family.kushalaya.com
NEXT_PUBLIC_FAMILY_PORTAL_URL=https://family.kushalaya.com/login

# Public product display name. Keep frontend + backend in sync.
# See docs/BRAND.md — do not change DEPLOY_VERTICAL when renaming the brand.
BRAND_NAME=KushAlaya
NEXT_PUBLIC_BRAND_NAME=KushAlaya
# NEXT_PUBLIC_BRAND_NAME=KushAlaya
# NEXT_PUBLIC_BRAND_MARK=KU
# NEXT_PUBLIC_BRAND_ACCENT=

# --- Deploy flags ---
RUN_BOOTSTRAP=0          # 1 on fresh VM only; 0 when ElderCare VM already bootstrapped
DEPLOY_WORKFORCEOS_CORE=1
DEPLOY_NGINX=1
DEPLOY_SYSTEMD=1
APP_SEED=admin           # admin | demo | skip  (admin/demo = super admin + SafeHome clients/family)
DEPLOY_TEKMATRIX_SITE=0  # SafeHome deploy usually skips corporate site

API_PORT=8010
WEB_PORT=3010

# Optional LiveWell AI providers (Contract C + E). Leave blank to keep local_stub.
# GEMINI_API_KEY=
# FAL_KEY=
# AI_VISION_PROVIDER=gemini
# AI_VISION_MODEL=gemini-3.5-flash
# AI_RENDER_PROVIDER=fal_kontext

# Session activity timeline (Session activity UI)
# standard (default): user actions + AI/system; API calls only for mutations/errors
# verbose: also log successful GETs (list sync, rubric, catalog, auth/me, …)
# ACTIVITY_LOG_MODE=standard

# Optional photo storage — Cloudflare R2 (S3-compatible). Default remains local disk.
# STORAGE_BACKEND=r2
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=livewell-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# After DB/init is already done, start/rebuild services only:
#   sudo bash scripts/deploy/start-livewell-services.sh
#   sudo bash scripts/deploy/start-livewell-services.sh --backend-migrate
#   sudo bash scripts/deploy/start-livewell-services.sh --skip-tls
