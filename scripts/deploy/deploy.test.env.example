# TEST instance (150.136.230.200) — see docs/deploy/TEST_INSTANCE.md
#
#   sudo mkdir -p /etc/workforceos
#   sudo cp scripts/deploy/deploy.test.env.example /etc/workforceos/safehome.env
#   sudo chmod 600 /etc/workforceos/safehome.env   # then fill the CHANGE_ME values
#   sudo bash scripts/deploy/deploy-safehome.sh
#
# Differences from production are marked TEST.

# --- Shared platform ---
WORKFORCEOS_CORE_REPO=git@github.com:krishnaposa/workforceos-core.git   # TEST: SSH + read-only deploy key
WORKFORCEOS_CORE_BRANCH=develop
WORKFORCEOS_CORE_PATH=/opt/workforceos-core

# --- App ---
APP_REPO=git@github.com:Ruka-Surendra-Kumar-Reddy/KUSHALAYA.git                     # TEST: SSH + read-only deploy key
APP_BRANCH=develop
APP_ROOT=/opt/safehomeops/app
APP_USER=safehomeops

# TEST hostnames (A records -> 150.136.230.200)
APP_DOMAIN=test-ops.kushalaya.com
MARKETING_DOMAIN=test.kushalaya.com
FAMILY_DOMAIN=test-family.kushalaya.com
NEXT_PUBLIC_FAMILY_PORTAL_URL=https://test-family.kushalaya.com/login
LEGACY_APP_DOMAIN=
INSTALL_LEGACY_REDIRECT=0
INSTALL_FAMILY_REDIRECT=0
KEEP_APP_DOMAIN=1

# --- PostgreSQL (own database on the test box; demo seed, never prod data) ---
APP_DB_USER=safehomeops
APP_DB_NAME=safehomeops
APP_DB_PASSWORD=CHANGE_ME_TEST_DB            # openssl rand -hex 24

# --- App secret (new one, never the prod value) ---
APP_SECRET_KEY=CHANGE_ME_TEST_SECRET          # openssl rand -hex 32

# --- TLS: SKIP_TLS=1 until the three DNS records resolve, then 0 and re-run ---
SKIP_TLS=1
CERTBOT_EMAIL=krishnaposa@kushalaya.com

# --- Brand (same as prod) ---
BRAND_NAME=KushAlaya
NEXT_PUBLIC_BRAND_NAME=KushAlaya

# TEST: show the yellow band and keep search engines out
ENVIRONMENT=test
NEXT_PUBLIC_ENVIRONMENT=test

# TEST: never contact a real person from this box
NOTIFICATION_EMAIL_PROVIDER=log
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
PAYMENTS_PROVIDER=stub                        # or razorpay with TEST-mode keys only
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# --- Deploy flags ---
RUN_BOOTSTRAP=1          # fresh VM: installs nginx, node, python, postgres, certbot
DEPLOY_WORKFORCEOS_CORE=1
DEPLOY_NGINX=1
DEPLOY_SYSTEMD=1
APP_SEED=demo            # TEST: super admin + Sunrise demo clients and family
DEPLOY_TEKMATRIX_SITE=0
API_PORT=8010
WEB_PORT=3010
# No IoT ingestor on test (watches talk to production only).
