# /etc/safehomeops/backup.env  (root:root, chmod 600)  — see docs/BACKUP.md
# No database password here: DATABASE_URL is read from /opt/safehomeops/app/backend/.env at run time.

# rclone remote + path (from `rclone config`), e.g. OCI Object Storage, S3, Google Drive:
BACKUP_RCLONE_REMOTE=oci-backup:kushalaya-backups/safehomeops
RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# gpg (AES-256, passphrase file) or age (identity file from `age-keygen -o`)
BACKUP_CIPHER=gpg
BACKUP_KEY_FILE=/etc/safehomeops/backup.key

BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
APP_ROOT=/opt/safehomeops/app
# BACKUP_UPLOADS_DIR=/opt/safehomeops/app/backend/uploads   # default: UPLOAD_DIR from backend/.env
# BACKUP_STATUS_FILE=/var/lib/safehomeops/backup/status.json
# RESTORE_PG_AS=postgres
