# Scripts run on Linux servers: never let Windows checkouts turn them into CRLF.
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.env.example text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.xlsx binary
