# STAGING backend/.env — template with placeholders. install-staging.sh fills the
# __PLACEHOLDERS__ on the VM from the production env (the values never enter
# this repo) and writes the result to /opt/safehomeops-staging/app/backend/.env.
#
# Deliberately NOT carried over from production: Razorpay keys, SMTP/SMS/
# WhatsApp providers, Gemini/FAL keys, IoT ingest key. Staging must not charge,
# email or message anyone. Add them by hand if a test needs them.

ENVIRONMENT=staging
LOG_LEVEL=INFO
DEPLOY_VERTICAL=LIVEWELL360
BRAND_NAME=__BRAND_NAME__

# Same PostgreSQL role as production, separate database.
DATABASE_URL=__DATABASE_URL__

# Fresh secret: production tokens are not valid on staging and vice versa.
SECRET_KEY=__SECRET_KEY__

CORS_ORIGINS=https://staging-ops.kushalaya.com,https://staging-www.kushalaya.com,https://staging-family.kushalaya.com

STORAGE_BACKEND=local
UPLOAD_DIR=/var/lib/safehomeops-staging/uploads
MAX_UPLOAD_MB=10
ENABLE_TELEMETRY=false

NOTIFICATION_EMAIL_PROVIDER=log
NOTIFICATION_SMS_PROVIDER=log
NOTIFICATION_WHATSAPP_PROVIDER=log
