[Unit]
Description=SafeHomeOps STAGING API (FastAPI, :8020, DB safehomeops_staging)
After=network.target postgresql.service

[Service]
User=safehomeops
Group=safehomeops
WorkingDirectory=/opt/safehomeops-staging/app/backend
EnvironmentFile=/opt/safehomeops-staging/app/backend/.env
ExecStart=/opt/safehomeops-staging/app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
