[Unit]
Description=SafeHomeOps API (FastAPI)
After=network.target postgresql.service

[Service]
User=safehomeops
Group=safehomeops
WorkingDirectory=/opt/safehomeops/app/backend
EnvironmentFile=/opt/safehomeops/app/backend/.env
ExecStart=/opt/safehomeops/app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
